{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "comments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "finding_id": {
            "type": "string",
            "pattern": "^F-[0-9]{3,}$"
          },
          "comment": {
            "type": "string",
            "minLength": 1
          },
          "code": {
            "type": "string"
          }
        },
        "required": [
          "finding_id",
          "comment"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "comments"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
