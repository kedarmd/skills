{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pr-review-finding-schema-1.0",
  "title": "pr-review finding",
  "type": "object",
  "required": ["id", "severity", "status", "title", "summary", "locations", "reason", "impact", "evidence", "confidence", "suggestions"],
  "properties": {
    "id": { "type": "string", "pattern": "^F-[0-9]{3,}$" },
    "severity": { "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"] },
    "status": { "enum": ["new", "unresolved", "addressed", "resolved", "regressed", "discarded"] },
    "title": { "type": "string", "minLength": 1, "maxLength": 140 },
    "summary": { "type": "string", "minLength": 1 },
    "locations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["file", "start_line", "end_line"],
        "properties": {
          "file": { "type": "string", "minLength": 1 },
          "start_line": { "type": "integer", "minimum": 1 },
          "end_line": { "type": "integer", "minimum": 1 },
          "side": { "enum": ["LEFT", "RIGHT"] },
          "commit_sha": { "type": "string", "minLength": 7 }
        }
      }
    },
    "reason": { "type": "string", "minLength": 1 },
    "impact": { "type": "string", "minLength": 1 },
    "evidence": { "type": "string", "minLength": 1 },
    "code_excerpt": { "type": "string" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "suggestions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "comment"],
        "properties": {
          "id": { "type": "string", "pattern": "^S-[0-9]{3,}$" },
          "title": { "type": "string", "minLength": 1 },
          "comment": { "type": "string", "minLength": 1 },
          "code": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    }
  }
}
