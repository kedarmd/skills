{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "overview": {
      "type": "object",
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "intent": {
          "type": "object",
          "properties": {
            "stated_intent": {
              "type": "string",
              "minLength": 1
            },
            "implemented_changes": {
              "type": "string",
              "minLength": 1
            },
            "verdict": {
              "enum": [
                "matches",
                "partially_matches",
                "does_not_match",
                "insufficient_context"
              ]
            },
            "explanation": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "stated_intent",
            "implemented_changes",
            "verdict",
            "explanation"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "summary",
        "intent"
      ],
      "additionalProperties": false
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "severity": {
            "enum": [
              "CRITICAL",
              "HIGH",
              "MEDIUM",
              "LOW"
            ]
          },
          "status": {
            "enum": [
              "new",
              "unresolved",
              "addressed",
              "resolved",
              "regressed",
              "discarded"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 140
          },
          "locations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "file": {
                  "type": "string",
                  "minLength": 1
                },
                "start_line": {
                  "type": "integer",
                  "minimum": 1
                },
                "end_line": {
                  "type": "integer",
                  "minimum": 1
                },
                "side": {
                  "enum": [
                    "LEFT",
                    "RIGHT"
                  ]
                }
              },
              "required": [
                "file",
                "start_line",
                "end_line",
                "side"
              ],
              "additionalProperties": false
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "impact": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "recommendation": {
            "type": "string",
            "minLength": 1
          },
          "id": {
            "type": "string",
            "pattern": "^F-[0-9]{3,}$"
          }
        },
        "required": [
          "severity",
          "status",
          "title",
          "locations",
          "reason",
          "impact",
          "evidence",
          "id"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "overview",
    "findings"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
